POSTGRES_DB=agendavoice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_root
APP_DB_PASSWORD=CHANGE_ME_local_app_password
MIGRATOR_DB_PASSWORD=CHANGE_ME_local_migrator_password
DATABASE_URL=postgresql+psycopg://agendavoice_app:local_app_change_me@db:5432/agendavoice
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
APP_ENV=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=
# Only used for live PostgreSQL RLS and concurrency integration tests.
# Must point to an already-migrated test database with btree_gist enabled.
TEST_DATABASE_URL=

# Local email sink (Mailpit); enable TLS and credentials for production SMTP relays
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@agendavoice.local
SMTP_ENABLED=true
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
APPOINTMENT_CONFIRMATION_MINUTES=30
# Optional local LLM provider (Ollama); no cloud API key required
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
